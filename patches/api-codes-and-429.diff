+/** 429 envelope for the anti-abuse rate limiter; carries Retry-After. */
+export function respRateLimited(message: string, retryAfterSeconds: number) {
+  const seconds = Math.max(1, Math.ceil(retryAfterSeconds));
+  return Response.json(
+    { code: API_CODE_RATE_LIMITED, message, data: { retryAfterSeconds: seconds } },
+    { status: 429, headers: { 'cache-control': 'no-store', 'retry-after': String(seconds) } }
+  );
+}
